---
<%
@partition_filter = :all
@partition_qos_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
_resource_result = ERB.new(File.read(_partial_path)).result(binding)
%>
cluster: "pax"

bc_dynamic_js: true

attributes:
  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
<%= generate_partition_field.indent(2) %>
  bc_num_hours:
    label: "Number of Hours"
    wiget: 'number_field'
    help: |
      Up to 48 hours in public batch,gpu,and preempt partitions, up to 168 hours in contrib lab partitions.
    min: 1
    max: 168
    id: 'bc_num_hours'
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>


  login_email:
    label:  "Email (for CryoSPARC login)"
    widget: 'text_field'
    required: true
    help: |
      <span>Enter the email address you will use to sign in to CryoSPARC.</span>
    
  cryosparc_license_id:
    widget: text_field
    required: true
    label: CryoSPARC License
    pattern: "^[\\w]{8}-[\\w]{4}-[\\w]{4}-[\\w]{4}-[\\w]{12}$" 
    help: |
      <span>License ID format:</span>
      <code>xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx</code>

  cryosparc_dir:
    label: Cryosparc working directory
    widget: path_selector
    required: true
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home
    help: |
      <span>Select the directory where CryoSPARC state will be stored.</span><br/>
      <strong>This location will contain:</strong> database files, the run directory, and the cache directory.

  ssd_path:
    label: SSD cache path
    widget: path_selector
    required: true
    value: /tmp
    directory: /cluster/tufts
    favorites:
      - /tmp
      - /cluster/tufts
      - /cluster/home
    help: |
      <span>Select the path CryoSPARC should use for SSD cache.</span><br/>
      <strong>Default:</strong> <code>/tmp</code><br/>
      <span class="text-warning"><strong>Warning:</strong> <code>/tmp</code> has limited storage and may be too small for large jobs.</span>

  num_gpus:
    widget: "number_field"
    label: "Number of GPUs"
    value: 1
    min: 1
    max: 4
    step: 1
    help: "Number of GPUs to allocate (maximum 4)."

  version:
    label: Software Version
    widget: select
    options:
      - ["5.0.1"]

form:
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_type
  - num_gpus
  - version
  - login_email
  - cryosparc_license_id
  - cryosparc_dir
  - ssd_path
  - ta_qos
  - bc_email_on_started
