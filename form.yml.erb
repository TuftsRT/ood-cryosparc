---
cluster: "pax"

bc_dynamic_js: true

<%= ERB.new(File.read(File.expand_path('partials/gpu_discovery.erb', __dir__))).result(binding) %>

attributes:
  notice:
    widget: "text_field"
    label: "Notice"
    value: ""
    help: |
      <div id="resource-limits-notice" class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Important: Upcoming resource limits</strong><br/>
        From 10/02/2025, the following resource limit (maximum simultaneous resource allocation) will be applied to all early adopters:
        <ul style="margin: 0.5rem 0 0 1.25rem;">
          <li>CPU: 32</li>
          <li>CPU Memory: 256GB</li>
          <li>GPU: 2</li>
          <li>Maximum Job Timelimit: 48 hours</li>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" onclick="document.getElementById('resource-limits-notice').style.display='none'" aria-label="Close"></button>
      </div>
    html_options:
      style: "display: none;"
      readonly: true


<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/all_partition.yml").indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  login_email:
    label:  "Email (for CryoSPARC login)"
    widget: 'text_field'
    required: true
    
  cryosparc_license_id:
    widget: text_field
    required: true
    label: CryoSPARC License
    pattern: "^[\\w]{8}-[\\w]{4}-[\\w]{4}-[\\w]{4}-[\\w]{12}$" 
    help: |
      Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx 

  cryosparc_dir:
    label: Cryosparc working directory
    widget: path_selector
    required: true
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home
    help: "Select the CryoSPARC working directory. Cryosparc database, run directory, and cache directory will be saved here."

  version:
    label: Software Version
    widget: select
    options:
      - ["5.0.1"]

form:
  - notice
  - partition
  - bc_num_hours
  - num_cores 
  - num_memory
  - gpu_type
  - version
  - login_email
  - cryosparc_license_id
  - cryosparc_dir
