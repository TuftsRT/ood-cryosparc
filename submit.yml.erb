---
cluster: "pax"

<% host = `hostname`.strip %>
batch_connect:
  template: basic
  timeout: <%= [((bc_num_hours.blank? ? 1.0 : bc_num_hours.to_f) * 3600.0).to_i - 60, 600].max %>

script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  before_script: "before.sh.erb"
  script: "script.sh.erb"
  job_name: "OnDemand/Cryosparc"
  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "-p <%= partition %>"      
<%
  skip_gres = gpu_type == "none" || ["batch", "largemem", "rc2", "pangolinlab", "ruiguolab", "shushkovlab", "vaseylab"].include?(partition)
%>
<% unless skip_gres %>
  <% if gpu_type == "a100_40" %>
    - "--gres=gpu:a100:<%= num_gpus %>"
    - "--constraint=a100-40G"
  <% elsif gpu_type == "a100_80" %>
    - "--gres=gpu:a100:<%= num_gpus %>"
    - "--constraint=a100-80G"
  <% elsif gpu_type == "any" %>
    - "--gres=gpu:<%= num_gpus %>"
  <% else %>
    - "--gres=gpu:<%= gpu_type %>:<%= num_gpus %>"
  <% end %>
<% end %>
