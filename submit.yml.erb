---
cluster: "pax"

<% host = `hostname`.strip %>
batch_connect:
  template: "basic"
  timeout: <%= [((bc_num_hours.blank? ? 1.0 : bc_num_hours.to_f) * 3600.0).to_i - 60, 600].max %>

script:
  email: <%= ENV["USER"] %>@tufts.edu
  before_script: "before.sh.erb"
  script: "script.sh.erb"
  job_name: "OnDemand/Cryosparc"
  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--partition=<%= partition %>"
<% if partition == "preempt" %>
    - "--qos=preempt"
<% elsif !%w[batch gpu preempt].include?(partition) %>
    - "--qos=normal-contrib"
<% end %>
<%
  # gpu_type from resource_discovery.erb is a feature variant like "a100-40G".
  # The gres name is the part before the first "-"; the full variant is a
  # node constraint. Empty/"none" (CPU partitions) => no GPU request.
  gres_name = gpu_type.to_s.split('-', 2).first.to_s
  skip_gres = gres_name.empty? || gres_name == "none"
%>
<% if gres_name == "any" %>
    - "--gres=gpu:<%= num_gpus %>"
<% elsif !skip_gres %>
    - "--gres=gpu:<%= gres_name %>:<%= num_gpus %>"
  <% if gpu_type.include?('-') %>
    - "--constraint=<%= gpu_type %>"
  <% end %>
<% end %>
    <%- if defined?(ta_qos) && ta_qos == "interactive" -%>
    - "--qos=<%= ta_qos %>"
    <%- end -%>
