<%
  url = "http://#{host}.pax.tufts.edu:#{port}"
%>

<div class="card border-0 shadow-sm" style="max-width: 52rem;">
  <div class="card-body p-4">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
      <div>
        <h3 class="h4 mb-1">CryoSPARC Session Ready</h3>
        <p class="text-muted mb-0">Open the web interface in a new tab, then sign in with the credentials below.</p>
      </div>
      <a class="btn btn-primary" href="<%= url %>" target="_blank" rel="noopener">
        <i class="fa fa-external-link"></i> Open CryoSPARC
      </a>
    </div>

    <div class="alert alert-info mb-3" role="alert">
      <div class="fw-bold mb-2"><i class="fa fa-info-circle"></i> Login</div>
      <div><strong>Email:</strong> the login email you entered in the form</div>
      <div><strong>Password:</strong> the first 8 characters of your CryoSPARC license ID</div>
    </div>

    <div class="mb-3">
      <div class="small text-uppercase text-muted fw-bold mb-2">Connection URL</div>
      <div class="bg-light border rounded px-3 py-2">
        <code><%= url %></code>
      </div>
    </div>

    <div class="alert alert-warning mb-0" role="alert">
      <strong>Note:</strong> If the page does not load immediately, wait a little longer and refresh. CryoSPARC services can take extra time to finish starting.
    </div>
  </div>
</div>
